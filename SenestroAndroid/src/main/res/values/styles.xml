<resources>

    <style name="Custom.HintTextAppearance" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/dark_gray</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Custom.AlertDialog" parent="Theme.AppCompat.Light.Dialog">
        <!-- Customize your dialog's appearance -->
        <item name="colorAccent">@color/cornflower_blue</item> <!-- Button color -->
        <item name="android:textColorPrimary">@color/black</item> <!-- Text color -->
        <item name="android:windowBackground">@color/white</item> <!-- Background color -->
        <item name="android:layout_margin">2dp</item> <!-- Margin -->
        <item name="android:windowMinWidthMajor">90%</item> <!-- Width customization -->
        <item name="android:windowMinWidthMinor">90%</item> <!-- Width customization -->
        <!-- Apply custom text appearances -->
        <item name="android:textAppearanceLarge">@style/Custom.DialogTitleAppearance</item> <!-- Title text -->
        <item name="android:textAppearanceMedium">@style/Custom.DialogMessageAppearance</item> <!-- Message text -->
        <item name="buttonBarPositiveButtonStyle">@style/Custom.DialogButton</item> <!-- Button text -->
        <item name="buttonBarNegativeButtonStyle">@style/Custom.DialogButton</item> <!-- Button text -->
        <item name="buttonBarNeutralButtonStyle">@style/Custom.DialogButton</item> <!-- Button text -->
    </style>

    <style name="Custom.DialogTitleAppearance" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/rockwell</item>
    </style>

    <style name="Custom.DialogMessageAppearance" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/dark_gray</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/bookos</item>
    </style>

    <style name="Custom.DialogButton" parent="Widget.AppCompat.Button">
        <item name="android:textColor">@color/blue_violet</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/bookos</item>
    </style>

    <!--    Default EditText theme-->
    <style name="Custom.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@color/light_gray</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColorHint">@color/gray</item>
        <item name="android:padding">6dp</item>
        <item name="android:elevation">4dp</item>
        <item name="android:fontFamily">@font/bookos</item>
        <item name="android:strokeWidth">1</item>
        <item name="android:strokeColor">@color/black</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAppearance">@style/Custom.TextAppearance</item>
    </style>

    <!--Default text appearance theme-->
    <style name="Custom.TextAppearance" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/bookos</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <!--Default button appearance theme-->
    <style name="Custom.ButtonAppearance" parent="TextAppearance.AppCompat">
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Custom.SpinnerProgressBar" parent="Widget.AppCompat.ProgressBar">
        <item name="android:indeterminateDrawable">@drawable/custom_progress_bar_spinner</item>
        <item name="android:indeterminate">true</item>
    </style>

    <style name="Custom.HorizontalProgressBar" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/custom_progress_bar_horizontal</item>
        <item name="android:layout_height">10dp</item>
        <item name="android:max">100</item>
        <item name="android:progress">0</item>
    </style>
</resources>