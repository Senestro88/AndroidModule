<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                                   xmlns:app="http://schemas.android.com/apk/res-auto"
                                                   xmlns:tools="http://schemas.android.com/tools"
                                                   android:id="@+id/advance_video_player_root"
                                                   android:layout_width="match_parent"
                                                   android:layout_height="match_parent"
                                                   android:layout_gravity="center_horizontal|center_vertical"
                                                   android:background="@color/black">

    <com.google.android.exoplayer2.ui.StyledPlayerView
            android:id="@+id/advance_video_player_styled_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foregroundGravity="center_vertical|center_horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:use_controller="false"/>


    <FrameLayout
            android:id="@+id/advance_video_player_frame_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/transparent"
            android:foregroundGravity="center_vertical|center_horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
                android:id="@+id/advance_video_player_frame_title_and_timers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="@color/transparent_black"
                android:gravity="center_horizontal|center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

            <TextView
                    android:id="@+id/advance_video_player_frame_player_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/cambria"
                    android:paddingLeft="8dp"
                    android:paddingTop="6dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="6dp"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"/>

            <LinearLayout
                    android:id="@+id/advance_video_player_frame_elapsed_time_and_total_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal|center_vertical"
                    android:orientation="horizontal">

                <TextView
                        android:id="@+id/advance_video_player_frame_elapsed_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/cambria"
                        android:paddingLeft="8dp"
                        android:paddingTop="6dp"
                        android:paddingRight="8dp"
                        android:paddingBottom="6dp"
                        android:textColor="#FFFFFF"/>

                <TextView
                        android:id="@+id/advance_video_player_frame_total_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/cambria"
                        android:paddingLeft="8dp"
                        android:paddingTop="6dp"
                        android:paddingRight="8dp"
                        android:paddingBottom="6dp"
                        android:textColor="#FFFFFF"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
                android:id="@+id/advance_video_player_frame_controls_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@color/transparent_black"
                android:orientation="vertical"
                android:padding="6dp">

            <SeekBar
                    android:id="@+id/advance_video_player_frame_seekbar"
                    style="@android:style/Widget.Material.SeekBar"
                    android:layout_width="fill_parent"
                    android:layout_height="10dp"
                    android:layout_gravity="center_horizontal|center_vertical"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="10dp"
                    android:indeterminateOnly="false"
                    android:progressDrawable="@drawable/advance_video_player_seekbar_progress"
                    android:max="100"
                    android:progress="0"
                    android:thumb="@drawable/advance_video_player_seekbar_thumb"/>

            <LinearLayout
                    android:id="@+id/advance_video_player_frame_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:orientation="horizontal"
                    android:padding="2dp">

                <ImageView
                        android:id="@+id/advance_video_player_frame_rewind_image"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_weight="1"
                        android:padding="4dp"
                        app:srcCompat="@mipmap/ic_controls_rewind_white"
                        tools:ignore="ContentDescription,ImageContrastCheck"/>

                <ImageView
                        android:id="@+id/advance_video_player_frame_play_image"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_weight="1"
                        android:padding="2dp"
                        app:srcCompat="@mipmap/ic_play_white"
                        tools:ignore="ContentDescription,ImageContrastCheck"/>

                <ImageView
                        android:id="@+id/advance_video_player_frame_forward_image"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_weight="1"
                        android:padding="4dp"
                        app:srcCompat="@mipmap/ic_controls_fast_forward_white"
                        tools:ignore="ContentDescription,ImageContrastCheck"/>

            </LinearLayout>

        </LinearLayout>
    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>